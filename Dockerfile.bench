# BrazilBench reproduction image. Offline, CPU only, no .env, no LLM keys.
#   make docker-bench                      # build, then `make reproduce` with outputs mounted back
#   docker run --rm brazilbench make bench # fast baseline printout
# Python: exact version from .python-version (uv-managed). Deps: uv.lock, frozen.
FROM ghcr.io/astral-sh/uv:0.11.7-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends make \
 && rm -rf /var/lib/apt/lists/*

ENV UV_LINK_MODE=copy \
    UV_NO_SYNC=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY . .

# Exact interpreter pinned in .python-version, then exactly uv.lock minus the
# GPU-only tail (torch + CUDA/triton wheels, several GB) that only the lazily
# imported Kronos analyst needs. BrazilBench never imports it
# (tests/test_brazilbench.py pins the import surface).
RUN uv python install \
 && uv sync --frozen --no-dev \
      $(uv export --frozen --no-dev --no-hashes --no-emit-project \
        | grep -oE '^(torch|triton|cuda-[a-z-]+|nvidia-[a-z0-9-]+)' \
        | sort -u | sed 's/^/--no-install-package /')

CMD ["make", "reproduce"]
