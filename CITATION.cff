license: Apache-2.0
repository-code: "https://github.com/RAFAELDCOELHO/autonomous-hedge-fund"
url: "https://github.com/RAFAELDCOELHO/autonomous-hedge-fund"
date-released: 2026-09-01
abstract: >-
  A multi-agent LLM trading system that extends the TradingAgents
  framework with an original Macro Economist Agent. BrazilBench runs
  offline classical baselines on frozen B3 regime splits for ITUB4,
  BPAC11, PETR4, VALE3, WEGE3, and RADL3.
preferred-citation:
  type: article
  title: "BrazilBench: A Reproducible Multi-Regime Benchmark for Trading Agents on Brazilian Equities"
